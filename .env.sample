# fileshare runtime settings (committed template -- copy to .env locally and
# fill in). No build pins: the image is built from the source in this
# directory. Fill in UPLOAD_TOKEN / MCP_API_KEY only in the local .env.

# Where the app (upload page, /api, /mcp) and the shared content are reached.
# Use TWO hostnames: uploaded HTML/JS runs on CONTENT_URL and must not share
# an origin with the upload page and /mcp. Same value = single-host mode.
PUBLIC_URL=https://share.example.de
CONTENT_URL=https://share-content.example.de

# Share lifetime: requested per upload (30m, 24h, 7d ...), clamped to MAX_EXPIRY.
DEFAULT_EXPIRY=24h
MAX_EXPIRY=30d
# Per upload, total (a zip counts with its unpacked size). K/M/G suffixes.
MAX_UPLOAD_SIZE=1G
# Files per share, on every upload path (multipart, zip contents, MCP).
MAX_FILES=10000
SWEEP_INTERVAL=5m
# Abort an upload that sends no data for this long, and cap how many
# uploads run at once (more get 503 + Retry-After).
UPLOAD_IDLE_TIMEOUT=60s
MAX_CONCURRENT_UPLOADS=16
# Serve shares with `Content-Security-Policy: sandbox ...`: every shared
# page gets its own opaque origin (no shared localStorage/cookies between
# shares or with sibling hosts). Pages that need localStorage or cookies
# break; set false only if you need that and trust the uploaders.
CONTENT_SANDBOX=true

# Empty = anonymous uploads. Set to require `Authorization: Bearer <token>`.
# Recommended for anything reachable from the internet: there is no global
# disk quota or per-client rate limit, so anyone could fill the data volume.
UPLOAD_TOKEN=
# /mcp requires `Authorization: Bearer <key>` or `X-API-Key: <key>`.
# Replace the placeholder (e.g. `openssl rand -hex 32`) -- fileshare refuses
# to start while it still contains CHANGE_ME. Empty = /mcp unauthenticated
# (only sensible when /mcp isn't reachable from outside).
MCP_API_KEY=CHANGE_ME
# Extra Host names accepted on /mcp (comma separated), e.g. the compose
# service name when an agent container reaches it as http://fileshare:8080/mcp.
MCP_ALLOWED_HOSTS=fileshare
# Largest file read_file returns through MCP; largest MCP request (base64
# uploads are ~4/3 of the file size).
MCP_MAX_READ=5M
MCP_MAX_BODY=32M

LOG_LEVEL=info

# Global (the binary logs in UTC; kept for consistency with the other images)
TZ=Europe/Berlin
