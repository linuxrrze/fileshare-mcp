# fileshare: anonymous, expiring file shares behind unguessable URLs, with an
# MCP endpoint for agents.
#   cp docker-compose.yml.sample docker-compose.yml
#   cp .env.sample .env        # set PUBLIC_URL / CONTENT_URL (+ optional tokens)
#   mkdir -p fs/data && sudo chown 1000:1000 fs/data
#   docker compose up -d
#
# Put a TLS reverse proxy in front for BOTH hostnames (PUBLIC_URL and
# CONTENT_URL), forwarding the original Host header, with no body size limit
# and request buffering off -- see README "Reverse proxy".

services:
  fileshare:
    image: git.linux-ng.de/marcel/fileshare:latest
    container_name: fileshare
    restart: unless-stopped
    # .env must exist locally: cp .env.sample .env
    env_file: .env
    volumes:
      - /etc/localtime:/etc/localtime:ro
      # Shares (one directory per share, removed on expiry). Owned by 1000.
      - ./fs/data:/data
    # Only the reverse proxy should reach it; bind to localhost (or drop
    # `ports:` and put the proxy on a shared network instead).
    ports:
      - "127.0.0.1:8080:8080"
    # Traefik: one router per hostname, both to the same service. The Host()
    # rules must match PUBLIC_URL and CONTENT_URL in .env. Traefik already
    # passes the Host header, streams request bodies (no buffering, no size
    # limit) and flushes SSE on /mcp -- but its entrypoint readTimeout
    # (default 60s) also cuts off slow uploads; see README "Reverse proxy".
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.fileshare.rule=Host(`share.example.de`)"
      - "traefik.http.routers.fileshare.entrypoints=https"
      - "traefik.http.routers.fileshare.tls=true"
      - "traefik.http.routers.fileshare.tls.certresolver=letsEncrypt"
      - "traefik.http.routers.fileshare.service=fileshare"
      - "traefik.http.routers.fileshare-content.rule=Host(`share-content.example.de`)"
      - "traefik.http.routers.fileshare-content.entrypoints=https"
      - "traefik.http.routers.fileshare-content.tls=true"
      - "traefik.http.routers.fileshare-content.tls.certresolver=letsEncrypt"
      - "traefik.http.routers.fileshare-content.service=fileshare"
      - "traefik.http.services.fileshare.loadbalancer.server.port=8080"
      ## Optional, for an internet-facing instance without UPLOAD_TOKEN: rate
      ## limit the app host (upload page, /api, /mcp) per client IP.
      # - "traefik.http.middlewares.fileshare-ratelimit.ratelimit.average=10"
      # - "traefik.http.middlewares.fileshare-ratelimit.ratelimit.burst=20"
      # - "traefik.http.routers.fileshare.middlewares=fileshare-ratelimit"
      ## Only if the container is on more than one network: tell Traefik
      ## which one it shares with the container.
      # - "traefik.docker.network=traefik"
    # A real deployment needs a network shared with Traefik -- add it here
    # per deployment (left out of the sample, as in the other images).
    # Hardening: the binary only writes to /data and needs no privileges.
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    # Uploads stream to disk, so memory stays small; this caps the damage
    # of anything unforeseen to this container instead of the host.
    mem_limit: 512m
    # Threads count as pids (tokio's blocking pool can grow to 512).
    pids_limit: 1024
    # Uncomment to let containers on codingenv's network use
    # http://fileshare:8080/mcp (keep MCP_ALLOWED_HOSTS=fileshare in .env).
    # networks:
    #   - default
    #   - codingenv

# networks:
#   codingenv:
#     external: true
#     name: ${CODINGENV_NETWORK:-codingenv_default}
